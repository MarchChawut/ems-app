# ============================================
# EMS — ตัวอย่างไฟล์ตั้งค่า (คัดลอกเป็น .env แล้วแก้ค่า — ห้าม commit ไฟล์ .env จริง)
# ค่าด้านล่างเป็น placeholder เท่านั้น ไม่มีความลับจริง
# ============================================

# --- ฐานข้อมูล (MariaDB/MySQL) ---
DATABASE_URL="mysql://ems_user:CHANGE_ME@127.0.0.1:3306/ems"

# --- ความปลอดภัย (จำเป็น) ---
# คีย์เข้ารหัส TOTP secret ของ 2FA: base64 ของ 32 ไบต์  → openssl rand -base64 32
TWO_FACTOR_ENC_KEY=""
# ความลับของ cron/worker (header x-cron-secret)         → openssl rand -hex 32
CRON_SECRET=""

# --- Passkey / HTTPS (ต้องเป็นโดเมนจริง + HTTPS; ใช้ IP ไม่ได้ — ถ้าใช้ไม่ได้ระบบข้ามขั้นบังคับ passkey) ---
RP_ID="localhost"
RP_NAME="EMS"
WEBAUTHN_ORIGIN="http://localhost:3000"
# ENFORCE_PASSKEY_SETUP=true
# FORCE_HTTPS=true
# ALLOWED_ORIGINS=""            # origin ข้ามเว็บที่อนุญาต คั่นด้วย , (same-origin อนุญาตเสมอ)
# TRUSTED_PROXY_HOPS=1          # จำนวน reverse proxy ที่เชื่อถือหน้าแอป

# --- บัญชี Super Admin เริ่มต้น (ใช้ตอน pnpm db:seed ครั้งแรกเท่านั้น) ---
# seed สร้างบัญชีนี้บัญชีเดียว พนักงานอื่นเพิ่มเองที่หน้า "พนักงาน" (ทีละคนหรือนำเข้า CSV)
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_NAME="ผู้ดูแลระบบ"
# SEED_ADMIN_EMAIL=""
# รหัสผ่านเริ่มต้น ≥ 12 ตัวอักษร (production บังคับตั้ง; ไม่ตั้งใน dev = สุ่มให้และแสดงครั้งเดียว) — ต้องเปลี่ยนตอนล็อกอินครั้งแรก
SEED_ADMIN_PASSWORD=""
# SEED_ENABLE_ALL_FEATURES=true   # เปิดทุกฟีเจอร์ตอนติดตั้งใหม่ (เดโม/CI) — ปกติเริ่มด้วยแท็บหลักเท่านั้น

# --- แจ้งเตือนทาง LINE (ไม่บังคับ — ไม่ตั้งก็ใช้งานได้ ระบบไม่ส่งแจ้งเตือน) ---
# LINE_CHANNEL_ACCESS_TOKEN=""
# LINE_CHANNEL_SECRET=""
# LINE_GROUP_ID=""

# --- อื่นๆ ---
# LOG_LEVEL=info
# สคริปต์ล้าง/เตรียมข้อมูลทดสอบ (scripts/reset-test-data.ts) — ไม่ตั้ง = สุ่มรหัสให้และแสดงครั้งเดียว
# TEST_ACCOUNT_PASSWORD=""
